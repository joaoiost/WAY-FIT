# Copie este arquivo para .env e preencha com as credenciais do projeto Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave pública do par VAPID (notificações push). Gere um par novo com
# `npx web-push generate-vapid-keys` — a privada NUNCA vai aqui, só no
# secrets das Edge Functions do Supabase.
VITE_VAPID_PUBLIC_KEY=sua-vapid-public-key-aqui
